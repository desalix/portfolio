---
import XIcon from '../assets/X.svg';
import LinkedinIcon from '../assets/Linkedin.svg';
import GitHubIcon from '../assets/GitHub.svg';

const year = new Date().getFullYear()

const SOCIALS = [
	{ href: 'https://www.linkedin.com/in/diego-de-salas/', icon: LinkedinIcon, label: 'LinkedIn' },
	{ href: 'https://github.com/desalix', icon: GitHubIcon, label: 'GitHub' },
]
---

<footer class="mt-24 px-4 pb-10">
    <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-5xl">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="font-display font-semibold text-ink">Diego De Salas</p>
                <p class="text-xs text-ink-muted">© {year} · Built with Astro &amp; Tailwind CSS</p>
            </div>
            <ul class="flex flex-row items-center gap-2">
                {SOCIALS.map(social => (
                    <li>
                        <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} class="socials">
                            <img src={social.icon.src} alt="" aria-hidden="true" class="socials-svg" />
                        </a>
                    </li>
                ))}
            </ul>
            </div>
        </div>
    </div>
</footer>
